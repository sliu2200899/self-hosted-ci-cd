# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Terraform
#
# The cluster provisioning code is kept out of this repo entirely. It holds live
# credentials: the tfvars carries a service principal secret, and AKS state
# contains kube_config_raw plus client certificates — anyone with those has
# cluster admin.
aks-terraform/

# Belt and braces, in case Terraform is ever run elsewhere in the tree.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
